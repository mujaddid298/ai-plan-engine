# ==========================================
# AI Model Provider Configuration
# ==========================================
# Provider: "openrouter", "anthropic", "openai", "google", etc.
AI_PROVIDER=openrouter
AI_API_KEY=your_ai_api_key_here
AI_MODEL=anthropic/claude-3.5-sonnet
# Optional: Custom endpoint (e.g., https://openrouter.ai/api/v1)
AI_BASE_URL=https://openrouter.ai/api/v1

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Random secret string for webhook header verification
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_min_8_chars
# Your Telegram User ID (Numeric ID from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=123456789

# ==========================================
# Database Configuration (LibSQL / SQLite)
# ==========================================
# For local dev: "file:local.db"
# For Turso / Cloud: "libsql://your-db.turso.io"
DATABASE_URL=file:local.db
# Required only if using Turso cloud
DATABASE_AUTH_TOKEN=

# ==========================================
# Security & Budget
# ==========================================
# Public URL for webhooks (e.g., https://your-domain.vercel.app)
APP_URL=http://localhost:3000
# Single shared password for web app access gate
APP_PASSWORD=supersecretpassword
# Daily expenditure ceiling in USD
DAILY_BUDGET_USD=5.0
